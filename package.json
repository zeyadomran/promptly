{
  "name": "promptly",
  "productName": "Promptly",
  "version": "1.0.1",
  "description": "A local desktop library for reusable text snippets.",
  "private": true,
  "license": "MIT",
  "main": ".vite/build/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=22.23.2 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make --platform=win32 --arch=x64",
    "stage:unsigned": "node scripts/stage-windows-artifacts.mjs",
    "lint": "eslint . --max-warnings 0 && npm run check:architecture",
    "check:architecture": "node scripts/check-architecture.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.tools.json",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "check": "npm run check:static && npm test",
    "check:static": "npm run typecheck && npm run lint && npm run format:check"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "electron-squirrel-startup": "1.0.1",
    "get-nonce": "1.0.1",
    "lucide-react": "1.50.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@electron/windows-sign": "2.1.0",
    "@eslint/js": "10.0.1",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.5.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.13.0",
    "oxc-parser": "0.152.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "electron-winstaller@5.4.4": true
  },
  "additionalFiles": [
    {
      "src": "LICENSES.chromium.html",
      "target": "lib/net45"
    }
  ]
}
